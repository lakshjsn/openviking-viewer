# OpenViking Viewer 配置示例
# 复制此文件为 .env 并根据你的环境修改

# OpenViking CLI 命令路径
# 如果 ov 不在 PATH 中，请设置完整路径
# OV_COMMAND=/usr/local/bin/ov
# OV_COMMAND=$HOME/.cargo/bin/ov

# OpenViking 服务地址和端口
# OV_HOST=localhost
# OV_PORT=1933

# OpenViking 存储路径（可选）
# OV_STORAGE_PATH=/path/to/viking/storage

# Viewer 服务端口
# OV_VIEWER_PORT=3199
